  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName.startsWith(\"01 \")) {",
          "  const suffix = Date.now().toString();",
          "  pm.collectionVariables.set(\"demoDocument\", \"DEMO-\"+suffix);",
          "  pm.collectionVariables.set(\"demoProfesional\", \"DEMO-\"+suffix);",
          "  pm.collectionVariables.set(\"demoOperacion\", \"DEMO-\"+suffix);",
          "  const date = new Date(Date.now()+3*24*60*60*1000);",
          "  date.setUTCMinutes(30,0,0);",
          "  pm.collectionVariables.set(\"fechaCita\", date.toISOString());",
          "  pm.collectionVariables.set(\"fechaCitaAlterna\", new Date(date.getTime()+24*60*60*1000).toISOString());",
          "  pm.collectionVariables.set(\"fechaReprogramacion\", new Date(date.getTime()+2*24*60*60*1000).toISOString());",
          "}"
        ]
      }
    }
