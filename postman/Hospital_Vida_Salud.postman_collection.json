      "name": "01 Registrar paciente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pacientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoDocumento\": \"OTRO\",\n  \"numeroDocumento\": \"{{demoDocument}}\",\n  \"nombres\": \"Paciente\",\n  \"apellidos\": \"Demostracion\",\n  \"fechaNacimiento\": \"1990-01-01\",\n  \"telefono\": \"000000000\",\n  \"correo\": \"demo@example.test\",\n  \"direccion\": \"Direccion ficticia\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"pacienteId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
